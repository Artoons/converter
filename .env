# ---------------------------------------------------------------------------
# ARTOONS Converter — environment configuration (copy to `.env`)
# All variables are read at build time by Vite. Never put secrets here.
# ---------------------------------------------------------------------------

# Google AdSense (Web build only — ads are NEVER loaded in the desktop app).
# Leave empty to show the house fallback card instead of ads.
VITE_ADSENSE_CLIENT_ID=ca-pub-0000000000000000
VITE_ADSENSE_SLOT_LEFT=0000000000
VITE_ADSENSE_SLOT_RIGHT=0000000000

# Optional tip link (Ko-fi / Buy Me a Coffee / Stripe Payment Link).
# If the URL contains {amount}, it is replaced by the chosen tip (e.g. 5).
VITE_TIP_URL=https://ko-fi.com/Artoons

# GitHub "latest release" base URL. Installers are fetched from
#   <VITE_GITHUB_RELEASE_URL>/download/<stable-asset-name>
VITE_GITHUB_RELEASE_URL=https://github.com/Artoons/converter/releases/latest

# Optional: repository URL (defaults to the release URL minus /releases/...)
VITE_GITHUB_REPO_URL=https://github.com/Artoons/converter
# Optional: CORS-friendly URL of checksums-sha256.txt (falls back to the release asset link)
VITE_CHECKSUMS_URL=
