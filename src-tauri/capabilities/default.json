{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the ARTOONS Converter main window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "fs:default",
    "fs:allow-app-local-data-read",
    "fs:allow-app-local-data-write",
    "fs:allow-applocaldata-read-recursive",
    "fs:allow-applocaldata-write-recursive",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "http:default",
    "shell:allow-execute",
    "shell:allow-spawn",
    "opener:default"
  ]
}
