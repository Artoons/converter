{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ARTOONS Converter",
  "version": "1.0.0",
  "identifier": "net.artoons.converter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "ARTOONS Converter",
        "width": 1180,
        "height": 780,
        "minWidth": 820,
        "minHeight": 560,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "app", "appimage"],
    "category": "Utility",
    "shortDescription": "Universal file converter",
    "longDescription": "Open-source, offline, modular file converter for images, data, audio, video and documents.",
    "copyright": "MIT License",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
